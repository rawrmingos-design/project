APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=topup
DB_USERNAME=root
DB_PASSWORD=

BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120

MEMCACHED_HOST=127.0.0.1

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_HOST=
PUSHER_PORT=443
PUSHER_SCHEME=https
PUSHER_APP_CLUSTER=mt1

VITE_APP_NAME="${APP_NAME}"
VITE_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
VITE_PUSHER_HOST="${PUSHER_HOST}"
VITE_PUSHER_PORT="${PUSHER_PORT}"
VITE_PUSHER_SCHEME="${PUSHER_SCHEME}"
VITE_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"

# Provider API Configurations
# Digiflazz Configuration
DIGIFLAZZ_BASE_URL=https://api.digiflazz.com/v1/
DIGIFLAZZ_USERNAME=your_username
DIGIFLAZZ_API_KEY=your_api_key
DIGIFLAZZ_ENABLED=true
DIGIFLAZZ_TIMEOUT=30
DIGIFLAZZ_RETRY_ATTEMPTS=3
DIGIFLAZZ_WEBHOOK_SECRET=your_webhook_secret

# BangJeff Configuration
BANGJEFF_BASE_URL=https://bangjeff.com/api/
BANGJEFF_API_ID=your_api_id
BANGJEFF_API_KEY=your_api_key
BANGJEFF_ENABLED=true
BANGJEFF_TIMEOUT=30
BANGJEFF_RETRY_ATTEMPTS=3
BANGJEFF_WEBHOOK_SECRET=your_webhook_secret

# Topupedia Configuration
TOPUPEDIA_BASE_URL=https://api.topupedia.com/
TOPUPEDIA_API_KEY=your_api_key
TOPUPEDIA_SECRET_KEY=your_secret_key
TOPUPEDIA_ENABLED=false
TOPUPEDIA_TIMEOUT=30
TOPUPEDIA_RETRY_ATTEMPTS=3
TOPUPEDIA_WEBHOOK_SECRET=your_webhook_secret

# APIGames Configuration
APIGAMES_BASE_URL=https://apigames.id/api/
APIGAMES_API_ID=your_api_id
APIGAMES_API_KEY=your_api_key
APIGAMES_ENABLED=false
APIGAMES_TIMEOUT=30
APIGAMES_RETRY_ATTEMPTS=3
APIGAMES_WEBHOOK_SECRET=your_webhook_secret

# Provider Global Settings
PROVIDER_AUTO_SYNC=false
PROVIDER_SYNC_INTERVAL=3600
PROVIDER_SYNC_BATCH_SIZE=100
PROVIDER_SYNC_MAX_TIME=300

PROVIDER_AUTO_UPDATE_PRICES=false
PROVIDER_PRICE_UPDATE_INTERVAL=1800
PROVIDER_DEFAULT_MARKUP=10
PROVIDER_MIN_PROFIT_MARGIN=5

PROVIDER_WEBHOOKS_ENABLED=true
PROVIDER_VERIFY_WEBHOOK_SIGNATURES=true
PROVIDER_LOG_WEBHOOKS=true
PROVIDER_WEBHOOK_TIMEOUT=10

PROVIDER_FALLBACK_ENABLED=true
PROVIDER_PRIMARY=digiflazz
PROVIDER_MAX_FALLBACK_ATTEMPTS=3

PROVIDER_CACHE_ENABLED=true
PROVIDER_CACHE_TTL=300

PROVIDER_LOGGING_ENABLED=true
PROVIDER_LOG_REQUESTS=true
PROVIDER_LOG_RESPONSES=true
PROVIDER_LOG_ERRORS=true
PROVIDER_LOG_CHANNEL=daily
