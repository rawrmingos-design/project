# =====================================================
# Application
# =====================================================
# Wajib untuk boot aplikasi, URL utama, dan port dasar deployment Docker.
APP_NAME="Nama Toko Anda"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://domain-anda.com
APP_URL_CALLBACK=https://domain-anda.com
ASSET_URL=
MAIN_DOMAIN_URL=https://domain-anda.com
COMPOSE_PROJECT_NAME=topup-main
NGINX_PORT=9000
PMA_PORT=9001

# =====================================================
# Hosts / Routing
# =====================================================
# Isi bila public site, admin panel, atau docs memakai domain/subdomain terpisah.
# SESSION_DOMAIN boleh dikosongkan bila ingin host-only cookie.
FILAMENT_ADMIN_DOMAIN=
DOCS_DOMAIN=
DOCS_URL=
SESSION_DOMAIN=

# =====================================================
# SaaS Tenancy
# =====================================================
# Default true agar fitur SaaS tenant/storefront dan self-service onboarding
# mati kecuali deployment memang siap mengaktifkannya. Set false untuk enable.
SUSPENDED_TENANT=true

# =====================================================
# Logging
# =====================================================
# Production umumnya pakai log level error dan channel file harian.
LOG_CHANNEL=daily
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

# =====================================================
# Database
# =====================================================
# DATABASE_URL / DB_SOCKET / MYSQL_ATTR_SSL_CA opsional, isi hanya jika deployment Anda memerlukannya.
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=laravel_topup
DB_USERNAME=root
DB_PASSWORD=
DB_SOCKET=
DATABASE_URL=
MYSQL_ATTR_SSL_CA=
DB_ROOT_PASSWORD=rootpassword

# =====================================================
# Cache, Queue & Session
# =====================================================
# Default lean baseline ini aman untuk start. Jika production memakai Redis,
# biasanya CACHE/QUEUE/SESSION akan disesuaikan saat deploy.
BROADCAST_DRIVER=null
CACHE_DRIVER=file
FILESYSTEM_DRIVER=local
# =====================================================
# Object Storage / Cloudflare R2 (opsional)
# =====================================================
# Default tetap local assets. Ubah UPLOADS_DISK=r2 hanya jika R2 credential sudah valid.
# R2 object key mengikuti path local, contoh: assets/logo/logo.webp
UPLOADS_DISK=assets
UPLOADS_FALLBACK_DISK=assets
UPLOADS_PLACEHOLDER=assets/logo/favicon.webp
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_ACCOUNT_ID=
R2_BUCKET=
R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
R2_URL=https://cdn.domain-anda.com
R2_REGION=auto
R2_USE_PATH_STYLE_ENDPOINT=true
QUEUE_CONNECTION=sync
QUEUE_FAILED_DRIVER=database-uuids
SESSION_DRIVER=file
SESSION_CONNECTION=
SESSION_STORE=
SESSION_LIFETIME=1000
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax

# =====================================================
# Redis (opsional - aktifkan jika pakai Redis)
# =====================================================
# Isi blok ini bila cache/session/queue production memakai Redis.
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379
REDIS_DB=0
REDIS_CACHE_DB=1
REDIS_QUEUE=default

# =====================================================
# Trusted Proxy / Inbound Whitelist
# Isi dengan IP reverse proxy / load balancer yang memang
# Anda percaya. Gunakan "*" hanya untuk local/testing.
# Contoh:
# TRUSTED_PROXIES=127.0.0.1,10.0.0.10
# =====================================================
TRUSTED_PROXIES=
TRUSTED_PROXY_HEADERS=forwarded_for,forwarded_host,forwarded_port,forwarded_proto,aws_elb

# =====================================================
# Client Assets (Docker bind mounts)
# Pisahkan per client agar satu codebase bisa punya
# branding/gambar yang berbeda di VPS.
# Sesuaikan path hanya bila struktur bind mount di server berbeda.
# =====================================================
PUBLIC_PRODUCT_LOGO_PATH=./client-assets/default/public/assets/product_logo
PUBLIC_THUMBNAIL_PATH=./client-assets/default/public/assets/thumbnail
PUBLIC_BANNER_PATH=./client-assets/default/public/assets/banner
PUBLIC_BANNER_GAME_PATH=./client-assets/default/public/assets/banner_game
PUBLIC_LOGO_PATH=./client-assets/default/public/assets/logo
PUBLIC_MEDIA_PATH=./client-assets/default/public/assets/media
PUBLIC_ARTICLE_THUMBNAILS_PATH=./client-assets/default/public/articles/thumbnails

# =====================================================
# Realtime / Broadcast / Reverb / Pusher
# =====================================================
# Pertahankan blok ini bila live order / realtime dipakai.
# Jika tidak dipakai, BROADCAST_DRIVER bisa tetap null dan credential dikosongkan.
REVERB_SERVER=reverb
REVERB_SERVER_HOST=0.0.0.0
REVERB_SERVER_PORT=8080
REVERB_SERVER_PATH=
REVERB_HOST=
REVERB_PORT=443
REVERB_SCHEME=https
REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=
REVERB_MAX_REQUEST_SIZE=10000
REVERB_SCALING_ENABLED=false
REVERB_SCALING_CHANNEL=reverb
REVERB_PULSE_INGEST_INTERVAL=15
REVERB_TELESCOPE_INGEST_INTERVAL=15
REVERB_APP_PING_INTERVAL=60
REVERB_APP_ACTIVITY_TIMEOUT=30
REVERB_APP_MAX_CONNECTIONS=
REVERB_APP_MAX_MESSAGE_SIZE=10000
REVERB_APP_ACCEPT_CLIENT_EVENTS_FROM=members
REVERB_APP_RATE_LIMITING_ENABLED=false
REVERB_APP_RATE_LIMIT_MAX_ATTEMPTS=60
REVERB_APP_RATE_LIMIT_DECAY_SECONDS=60
REVERB_APP_RATE_LIMIT_TERMINATE=false
PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_HOST=
PUSHER_PORT=443
PUSHER_SCHEME=https
PUSHER_APP_CLUSTER=ap1
ABLY_KEY=

VITE_APP_NAME="${APP_NAME}"
VITE_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
VITE_PUSHER_HOST="${PUSHER_HOST}"
VITE_PUSHER_PORT="${PUSHER_PORT}"
VITE_PUSHER_SCHEME="${PUSHER_SCHEME}"
VITE_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"

# =====================================================
# Web Push / PWA Notification (VAPID)
# =====================================================
# Wajib diisi jika fitur push notification PWA dipakai.
# Generate keypair dengan library web-push / command deployment yang tersedia,
# lalu isi public/private key hasil generate. Jangan isi dengan contoh dummy.
WEBPUSH_VAPID_SUBJECT=mailto:admin@domain-anda.com
WEBPUSH_VAPID_PUBLIC_KEY=
WEBPUSH_VAPID_PRIVATE_KEY=

# =====================================================
# WhatsApp Gateway (Notifikasi Otomatis)
# =====================================================
# Isi hanya jika notifikasi WhatsApp otomatis dipakai di deployment ini.
WA_KEY=
WA_NUMBER=

# =====================================================
# Webhook Security Secrets
# WAJIB diisi! Kosongkan = webhook dari provider DITOLAK
# Dapatkan dari dashboard provider masing-masing.
# Isi hanya secret provider yang benar-benar aktif di deployment ini.
# =====================================================
DIGIFLAZZ_WEBHOOK_SECRET=
BANGJEFF_WEBHOOK_SECRET=
TOPUPEDIA_WEBHOOK_SECRET=
APIGAMES_WEBHOOK_SECRET=
VIP_WEBHOOK_SECRET=
TENANT_SUBSCRIPTION_WEBHOOK_TOKEN=

# =====================================================
# reCAPTCHA (Google)
# https://www.google.com/recaptcha/admin/create
# Aktif terutama untuk hardening login admin / auth form publik.
# =====================================================
NOCAPTCHA_SECRET=
NOCAPTCHA_SITEKEY=
ADMIN_LOGIN_CAPTCHA_ENABLED=true

# =====================================================
# Mail (SMTP)
# =====================================================
# Dipakai untuk email reset password, notifikasi, dan email sistem lain.
MAIL_MAILER=smtp
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="noreply@domain-anda.com"
MAIL_FROM_NAME="${APP_NAME}"

# =====================================================
# Notes
# =====================================================
# - Isi APP_KEY dengan hasil `php artisan key:generate`.
# - Provider credentials / advanced backend env sengaja tidak dimasukkan ke lean baseline ini.
# - Jika Redis / Reverb / provider tertentu tidak dipakai, biarkan kosong atau pakai default aman.
# - Jangan commit secret asli ke repository.
