# =====================================================
# Application
# =====================================================
APP_NAME="Nama Toko Anda"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://domain-anda.com
APP_URL_CALLBACK=https://domain-anda.com

# =====================================================
# Logging
# =====================================================
LOG_CHANNEL=daily
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

# =====================================================
# Database
# =====================================================
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=laravel_topup
DB_USERNAME=root
DB_PASSWORD=

# =====================================================
# Cache, Queue & Session
# =====================================================
BROADCAST_DRIVER=pusher
CACHE_DRIVER=file
FILESYSTEM_DRIVER=local
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=1000
SESSION_SECURE_COOKIE=true

# =====================================================
# Redis (opsional — aktifkan jika pakai Redis)
# =====================================================
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# =====================================================
# Pusher (untuk Live Order / Realtime)
# =====================================================
PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_HOST=
PUSHER_PORT=443
PUSHER_SCHEME=https
PUSHER_APP_CLUSTER=ap1

VITE_APP_NAME="${APP_NAME}"
VITE_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
VITE_PUSHER_HOST="${PUSHER_HOST}"
VITE_PUSHER_PORT="${PUSHER_PORT}"
VITE_PUSHER_SCHEME="${PUSHER_SCHEME}"
VITE_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"

# =====================================================
# Memcached
# =====================================================
MEMCACHED_HOST=127.0.0.1

# =====================================================
# WhatsApp Gateway (Notifikasi Otomatis)
# =====================================================
WA_KEY=
WA_NUMBER=

# =====================================================
# Webhook Security Secrets
# WAJIB diisi! Kosongkan = webhook dari provider DITOLAK
# Dapatkan dari dashboard provider masing-masing
# =====================================================
DIGIFLAZZ_WEBHOOK_SECRET=
BANGJEFF_WEBHOOK_SECRET=

# =====================================================
# Velixs — Fallback API Cek Nickname Game
# =====================================================
VELIXS_API_KEY=

# =====================================================
# reCAPTCHA (Google)
# https://www.google.com/recaptcha/admin/create
# =====================================================
NOCAPTCHA_SECRET=
NOCAPTCHA_SITEKEY=

# =====================================================
# Mail (SMTP)
# =====================================================
MAIL_MAILER=smtp
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="noreply@domain-anda.com"
MAIL_FROM_NAME="${APP_NAME}"
