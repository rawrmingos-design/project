{
  "info": {
    "name": "Outbound H2H MVP",
    "_postman_id": "7dc2a96c-ec6e-40ec-9f91-0f7f7705e901",
    "description": "Collection untuk menguji outbound callback live H2H MVP. Gunakan bersama admin panel untuk menyiapkan Reseller Integration dan Reseller Callback Profile, lalu verifikasi callback keluar di webhook receiver publik.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Orders",
      "item": [
        {
          "name": "Create Live Order",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const referenceNumber = `H2H-E2E-${Date.now()}`;",
                  "pm.variables.set('generated_reference_number', referenceNumber);"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Response code is 200 for valid live order', function () {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "",
                  "const json = pm.response.json();",
                  "pm.test('Order response marks success', function () {",
                  "  pm.expect(json.error).to.eql(false);",
                  "  pm.expect(json.data).to.have.property('invoiceNumber');",
                  "});",
                  "",
                  "if (json && json.data && json.data.invoiceNumber) {",
                  "  pm.environment.set('latest_invoice_number', json.data.invoiceNumber);",
                  "  pm.environment.set('last_reference_number', pm.variables.get('generated_reference_number'));",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{reseller_api_key}}",
                "type": "text"
              },
              {
                "key": "Accept",
                "value": "application/json",
                "type": "text"
              },
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              },
              {
                "key": "X-Reseller-Integration-Code",
                "value": "{{reseller_integration_code}}",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"code\": \"{{test_product_code}}\",\n  \"referenceNumber\": \"{{generated_reference_number}}\",\n  \"data\": \"{{test_user_data}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{api_base_url}}/api/v1/order",
              "host": [
                "{{api_base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "order"
              ]
            },
            "description": "Happy path live order. Expected: 200, invoice number tersimpan ke environment, lalu callback outbound keluar ke webhook receiver yang diset di admin."
          }
        },
        {
          "name": "Create Live Order - Missing Integration Header",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const referenceNumber = `H2H-NO-HEADER-${Date.now()}`;",
                  "pm.variables.set('generated_reference_number', referenceNumber);"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Response code is 422 when integration header is missing', function () {",
                  "  pm.response.to.have.status(422);",
                  "});",
                  "",
                  "const json = pm.response.json();",
                  "pm.test('Missing integration header message is returned', function () {",
                  "  pm.expect(json.error).to.eql(true);",
                  "  pm.expect(json.message).to.eql('X-Reseller-Integration-Code header is required');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{reseller_api_key}}",
                "type": "text"
              },
              {
                "key": "Accept",
                "value": "application/json",
                "type": "text"
              },
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"code\": \"{{test_product_code}}\",\n  \"referenceNumber\": \"{{generated_reference_number}}\",\n  \"data\": \"{{test_user_data}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{api_base_url}}/api/v1/order",
              "host": [
                "{{api_base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "order"
              ]
            },
            "description": "Negative test: order live tanpa header X-Reseller-Integration-Code harus ditolak 422."
          }
        },
        {
          "name": "Create Live Order - Invalid Integration Code",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const referenceNumber = `H2H-INVALID-CODE-${Date.now()}`;",
                  "pm.variables.set('generated_reference_number', referenceNumber);"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Response code is 403 when integration code is invalid', function () {",
                  "  pm.response.to.have.status(403);",
                  "});",
                  "",
                  "const json = pm.response.json();",
                  "pm.test('Invalid integration message is returned', function () {",
                  "  pm.expect(json.error).to.eql(true);",
                  "  pm.expect(json.message).to.eql('Invalid or inactive reseller integration code');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{reseller_api_key}}",
                "type": "text"
              },
              {
                "key": "Accept",
                "value": "application/json",
                "type": "text"
              },
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              },
              {
                "key": "X-Reseller-Integration-Code",
                "value": "{{invalid_reseller_integration_code}}",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"code\": \"{{test_product_code}}\",\n  \"referenceNumber\": \"{{generated_reference_number}}\",\n  \"data\": \"{{test_user_data}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{api_base_url}}/api/v1/order",
              "host": [
                "{{api_base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "order"
              ]
            },
            "description": "Negative test: integration code palsu atau milik user lain harus ditolak 403."
          }
        },
        {
          "name": "Status Order",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Response code is 200 for existing invoice', function () {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "",
                  "const json = pm.response.json();",
                  "pm.test('Status order response contains invoice and status code', function () {",
                  "  pm.expect(json.error).to.eql(false);",
                  "  pm.expect(json.data).to.have.property('invoiceNumber');",
                  "  pm.expect(json.data).to.have.property('statusCode');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{reseller_api_key}}",
                "type": "text"
              },
              {
                "key": "Accept",
                "value": "application/json",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{api_base_url}}/api/v1/status-order/{{latest_invoice_number}}",
              "host": [
                "{{api_base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "status-order",
                "{{latest_invoice_number}}"
              ]
            },
            "description": "Cek status order terakhir yang berhasil dibuat. latest_invoice_number diisi otomatis oleh request Create Live Order."
          }
        }
      ]
    }
  ]
}
