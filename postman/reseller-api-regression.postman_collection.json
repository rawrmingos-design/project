                  "});",
                  "const json = pm.response.json();",
                  "pm.test('Duplicate reference reuses same invoice safely', function () {",
                  "  pm.expect(json.error).to.eql(false);",
                  "  pm.expect(json.data).to.have.property('invoiceNumber');",
                  "  pm.expect(json.data.isDuplicate).to.eql(true);",
                  "});"
