        {
          "name": "Create Live Order - Insufficient Balance",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const isConfigured = !String(pm.environment.get('low_balance_reseller_api_key') || '').startsWith('replace-with');",
                  "const json = pm.response.json();",
                  "if (!isConfigured) {",
                  "  pm.test('Low balance credentials are configured before strict assertion', function () {",
                  "    pm.expect(pm.response.code).to.be.oneOf([400, 403]);",
                  "  });",
                  "} else {",
                  "  pm.test('Insufficient balance returns 400', function () {",
                  "    pm.response.to.have.status(400);",
                  "  });",
                  "  pm.test('Insufficient balance payload is stable', function () {",
                  "    pm.expect(json.error).to.eql(true);",
                  "    pm.expect(json.message).to.eql('Your Balance is Insufficient');",
                  "    pm.expect(json.error_code).to.eql('INSUFFICIENT_BALANCE');",
                  "  });",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{low_balance_reseller_api_key}}",
                "type": "text"
              },
              {
                "key": "Accept",
                "value": "application/json",
                "type": "text"
              },
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              },
              {
                "key": "X-Reseller-Integration-Code",
                "value": "{{low_balance_reseller_integration_code}}",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"code\": \"{{test_product_code}}\",\n  \"referenceNumber\": \"H2H-LOW-BALANCE-{{$timestamp}}\",\n  \"data\": \"{{test_user_data}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{api_base_url}}/api/v1/order",
              "host": [
                "{{api_base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "order"
              ]
            },
            "description": "Isi low_balance_reseller_api_key dan low_balance_reseller_integration_code dengan user live yang saldonya lebih kecil dari harga test_product_code."
          }
