        {
          "name": "Balance",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Balance returns 200', function () {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "const json = pm.response.json();",
                  "pm.test('Balance payload is successful', function () {",
                  "  pm.expect(json.error).to.eql(false);",
                  "  pm.expect(json.data).to.have.property('balance');",
                  "  pm.expect(json.data).to.have.property('membership');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{reseller_api_key}}",
                "type": "text"
