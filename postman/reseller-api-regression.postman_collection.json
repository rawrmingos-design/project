    {
      "name": "Orders",
      "item": [
        {
          "name": "Create Live Order",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const referenceNumber = `H2H-REG-${Date.now()}`;",
                  "pm.variables.set('generated_reference_number', referenceNumber);"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Create order returns 200', function () {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "const json = pm.response.json();",
                  "pm.test('Create order payload is successful', function () {",
                  "  pm.expect(json.error).to.eql(false);",
                  "  pm.expect(json.data).to.have.property('invoiceNumber');",
                  "});",
                  "if (json && json.data && json.data.invoiceNumber) {",
                  "  pm.environment.set('latest_invoice_number', json.data.invoiceNumber);",
                  "  pm.environment.set('last_reference_number', pm.variables.get('generated_reference_number'));",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{reseller_api_key}}",
                "type": "text"
              },
