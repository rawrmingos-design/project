    {
      "name": "Throttle",
      "item": [
        {
          "name": "Balance Burst",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const status = pm.response.code;",
                  "pm.test('Balance burst returns 200 or 429', function () {",
                  "  pm.expect([200, 429]).to.include(status);",
                  "});",
                  "if (status === 429) {",
                  "  const json = pm.response.json();",
                  "  pm.environment.set('last_retry_after', String(json.retryAfterSeconds || ''));",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{reseller_api_key}}",
