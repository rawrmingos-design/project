          "name": "Repeat Same Reference Number",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Duplicate reference returns 200', function () {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "const json = pm.response.json();",
                  "pm.test('Duplicate reference reuses same invoice safely', function () {",
                  "  pm.expect(json.error).to.eql(false);",
                  "  pm.expect(json.data).to.have.property('invoiceNumber');",
                  "  pm.expect(json.data.isDuplicate).to.eql(true);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{reseller_api_key}}",
                "type": "text"
              },
              {
                "key": "Accept",
                "value": "application/json",
                "type": "text"
              },
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              },
              {
                "key": "X-Reseller-Integration-Code",
                "value": "{{reseller_integration_code}}",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"code\": \"{{test_product_code}}\",\n  \"referenceNumber\": \"{{last_reference_number}}\",\n  \"data\": \"{{test_user_data}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{api_base_url}}/api/v1/order",
              "host": [
                "{{api_base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "order"
              ]
            },
            "description": "Jalankan setelah Create Live Order. Request ini memastikan referenceNumber yang sama tidak membuat order ganda."
          }
        },
        {
          "name": "Status Order",
