{
  "info": {
    "name": "Inbound Integration Whitelist",
    "_postman_id": "6c5ec7fb-9a52-46fa-8b59-16ef54d1c001",
    "description": "Collection untuk menguji middleware inbound whitelist dan callback controller. Gunakan bersama environment local agar signature callback bisa dihitung otomatis di pre-request script.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Diagnostics",
      "item": [
        {
          "name": "Resolve Client IP",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "X-Forwarded-For",
                "value": "{{simulate_source_ip}}",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{base_url}}/wip",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "wip"
              ]
            },
            "description": "Gunakan request ini untuk memastikan request()->ip() membaca IP yang diharapkan. Kalau TRUSTED_PROXIES belum benar, response akan tetap menunjukkan REMOTE_ADDR."
          }
        }
      ]
    },
    {
      "name": "Supplier Callback",
      "item": [
        {
          "name": "Digiflazz Callback Probe",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const payload = {",
                  "  data: {",
                  "    ref_id: pm.environment.get('digiflazz_ref_id'),",
                  "    status: 'Sukses'",
                  "  }",
                  "};",
                  "const raw = JSON.stringify(payload);",
                  "pm.variables.set('digiflazz_body', raw);",
                  "const secret = pm.environment.get('digiflazz_webhook_secret') || '';",
                  "const signature = 'sha1=' + CryptoJS.HmacSHA1(raw, secret).toString(CryptoJS.enc.Hex);",
                  "pm.variables.set('digiflazz_signature', signature);"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Response code is expected for middleware/controller flow', function () {",
                  "  pm.expect([200, 401, 403]).to.include(pm.response.code);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              },
              {
                "key": "X-Hub-Signature",
                "value": "{{digiflazz_signature}}",
                "type": "text"
              },
              {
                "key": "X-Digiflazz-Event",
                "value": "order_status_update",
                "type": "text"
              },
              {
                "key": "X-Forwarded-For",
                "value": "{{simulate_source_ip}}",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{{digiflazz_body}}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{base_url}}/wejizy/digi/payload",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "wejizy",
                "digi",
                "payload"
              ]
            },
            "description": "Expected: mode enforce + IP mismatch => 403. Mode log_only => request masuk controller, lalu signature/payload diverifikasi."
          }
        }
      ]
    },
    {
      "name": "Payment Gateway Callback",
      "item": [
        {
          "name": "TokoPay Callback Probe",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const reffId = pm.environment.get('tokopay_reff_id');",
                  "const merchantId = pm.environment.get('tokopay_merchant_id') || '';",
                  "const secret = pm.environment.get('tokopay_secret_key') || '';",
                  "const signature = CryptoJS.MD5(`${merchantId}:${secret}:${reffId}`).toString();",
                  "const payload = {",
                  "  status: 'Success',",
                  "  reference: pm.environment.get('tokopay_reference'),",
                  "  reff_id: reffId,",
                  "  signature: signature",
                  "};",
                  "pm.variables.set('tokopay_body', JSON.stringify(payload, null, 2));"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Response code is expected for middleware/controller flow', function () {",
                  "  pm.expect([200, 401, 403]).to.include(pm.response.code);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              },
              {
                "key": "X-Forwarded-For",
                "value": "{{simulate_source_ip}}",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{{tokopay_body}}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{base_url}}/wejizy/tokopay/callback",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "wejizy",
                "tokopay",
                "callback"
              ]
            },
            "description": "Expected: enforce + IP mismatch => 403. Jika whitelist pass dan signature benar, controller akan lanjut proses invoice."
          }
        },
        {
          "name": "TriPay Callback Probe",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const payload = {",
                  "  reference: pm.environment.get('tripay_reference'),",
                  "  status: 'PAID',",
                  "  total_amount: 50000",
                  "};",
                  "const raw = JSON.stringify(payload);",
                  "pm.variables.set('tripay_body', raw);",
                  "const secret = pm.environment.get('tripay_private_key') || '';",
                  "const signature = CryptoJS.HmacSHA256(raw, secret).toString(CryptoJS.enc.Hex);",
                  "pm.variables.set('tripay_signature', signature);"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Response code is expected for middleware/controller flow', function () {",
                  "  pm.expect([200, 400, 403]).to.include(pm.response.code);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              },
              {
                "key": "X-Callback-Signature",
                "value": "{{tripay_signature}}",
                "type": "text"
              },
              {
                "key": "X-Callback-Event",
                "value": "payment_status",
                "type": "text"
              },
              {
                "key": "X-Forwarded-For",
                "value": "{{simulate_source_ip}}",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{{tripay_body}}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{base_url}}/wejizy/tripay/callback",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "wejizy",
                "tripay",
                "callback"
              ]
            },
            "description": "Expected: enforce + IP mismatch => 403. Jika whitelist pass dan signature benar tetapi invoice tidak ada, controller akan mengembalikan ignored/not found flow."
          }
        }
      ]
    }
  ]
}
